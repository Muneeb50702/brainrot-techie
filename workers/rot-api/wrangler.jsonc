{
  // Shared AI backend for every brainrot site. One endpoint per tool: POST /v1/<tool>.
  // Secret (set once, never committed):  npx wrangler secret put ANTHROPIC_API_KEY --config workers/rot-api/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "rot-api.muhammadmuneeb.tech", "custom_domain": true }],
  "vars": {
    // Swap to "claude-haiku-5-5" for ~40x cheaper tokens if traffic explodes.
    "MODEL": "claude-opus-5-5",
    "EFFORT": "low"
  },
  "ratelimits": [
    // per visitor IP, per tool (period must be 10 or 60s)
    { "name": "PER_IP", "namespace_id": "2001", "simple": { "limit": 8, "period": 60 } },
    // global brake per Cloudflare location, protects the API bill if a reel goes viral
    { "name": "GLOBAL", "namespace_id": "2002", "simple": { "limit": 150, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
